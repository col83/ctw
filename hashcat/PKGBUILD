_pkgname=hashcat
pkgname=${_pkgname}-git
_pkgver=7.1.2
pkgver=${_pkgver}
pkgrel=1
pkgdesc='Multithreaded advanced password recovery utility'
url='https://hashcat.net/hashcat'
license=('MIT')
arch=('x86_64')

depends=('ocl-icd' 'xxhash' 'zlib' 'minizip')
makedepends=('opencl-headers' 'rust')

options=(!debug)

conflicts=("hashcat")
provides=('libhashcat.so')

source=(${pkgname}::git+https://github.com/hashcat/hashcat)

sha512sums=('SKIP')

pkgver() {
  cd ${pkgname}
  git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {

  cd ${pkgname}

  sed -ri 's!^(HASHCAT_ROOT=).*!\1\"/usr/bin\"!' extra/tab_completion/${_pkgname}.sh

}

build() {

  cd ${pkgname}

  rm -rf deps/{OpenCL-Headers,xxHash}

  export CFLAGS+=" ${CPPFLAGS}"
  export CXXFLAGS+=" ${CPPFLAGS}"

  make -j4 \
    PREFIX=/usr \
    DEBUG=0 \
    SHARED=1 \
    ENABLE_LTO=1 \
    ENABLE_BRAIN=1 \
    MAINTAINER_MODE=0 \
    USE_SYSTEM_XXHASH=1 \
    USE_SYSTEM_OPENCL=1 \
    USE_SYSTEM_ZLIB=1

}

check() {
  cd ${pkgname}
  tools/test_package.sh --no-device
}

package() {

  cd ${pkgname}

  make \
    DESTDIR="${pkgdir}" \
    PREFIX=/usr \
    DEBUG=0 \
    SHARED=1 \
    ENABLE_LTO=1 \
    ENABLE_BRAIN=1 \
    MAINTAINER_MODE=0 \
    USE_SYSTEM_XXHASH=1 \
    USE_SYSTEM_OPENCL=1 \
    USE_SYSTEM_ZLIB=1
    install

    install -Dm 644 extra/tab_completion/${pkgname}.sh "${pkgdir}/usr/share/bash-completion/completions/${pkgname}"

}

# vim: ts=2 sw=2 et:
